{
  "version": 1,
  "name": "embeddinggemma2_text_vision_int4_int8",
  "description": "Weight-only INT4 text and vocabulary / INT8 vision PTQ, with separate quantization and native fidelity checks.",
  "variables": {
    "images": "$repo/CoreAISamples/Resources/Recipes",
    "adapters": "$repo/Tools/Conversion/adapters/embeddinggemma2",
    "fixture": "$recipe_dir/fixtures.json"
  },
  "python": "$python",
  "environment": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "OMP_NUM_THREADS": "4",
    "MKL_NUM_THREADS": "4"
  },
  "steps": [
    {
      "id": "prepare",
      "role": "prepare",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.embeddinggemma2.prepare",
        "--contract",
        "$recipe_dir/model.json",
        "--snapshot",
        "$snapshot",
        "--build",
        "$native_build",
        "--runner",
        "$runner",
        "--out",
        "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/prepare.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$recipe_dir/model.json",
        "$recipe_dir/pyproject.toml",
        "$recipe_dir/uv.lock",
        "$native_build",
        "$runner",
        "$repo/CoreAISamplesKit/Package.swift",
        "$repo/CoreAISamplesKit/Package.resolved",
        "$repo/CoreAISamplesKit/Sources/EmbeddingCore",
        "$repo/CoreAISamplesKit/Sources/EmbeddingRuntime",
        "$repo/CoreAISamplesKit/Sources/embedding-verify",
        "$snapshot"
      ],
      "outputs": [
        "ready.json"
      ],
      "depends": [],
      "heavy": false,
      "cache": false,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000,
      "checks": [
        {
          "file": "ready.json",
          "key": [
            "ready"
          ],
          "equals": true
        }
      ]
    },
    {
      "id": "reference",
      "role": "reference",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.embeddinggemma2.reference",
        "--source",
        "$snapshot",
        "--images",
        "$images",
        "--fixtures",
        "$fixture",
        "--output",
        "$out/reference"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference.py",
        "$adapters/contracts.py",
        "$snapshot",
        "$fixture",
        "$images"
      ],
      "outputs": [
        "reference"
      ],
      "depends": [
        "prepare"
      ],
      "heavy": true,
      "cache": true,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000
    },
    {
      "id": "quantized_reference",
      "role": "reference",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.embeddinggemma2.quantized_reference",
        "--source",
        "$snapshot",
        "--reference",
        "$reference/reference",
        "--output",
        "$out/reference"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/quantized_reference.py",
        "$adapters/quantization.py",
        "$adapters/convert.py",
        "$adapters/model_wrappers.py",
        "$adapters/contracts.py",
        "$snapshot"
      ],
      "outputs": [
        "reference"
      ],
      "depends": [
        "reference"
      ],
      "heavy": true,
      "cache": true,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000
    },
    {
      "id": "text_export",
      "role": "export",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.embeddinggemma2.convert",
        "--source",
        "$snapshot",
        "--reference",
        "$quantized_reference/reference",
        "--kind",
        "text",
        "--precision",
        "int4_int8",
        "--output",
        "$out/model"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/convert.py",
        "$adapters/model_wrappers.py",
        "$adapters/contracts.py",
        "$snapshot",
        "$adapters/quantization.py"
      ],
      "outputs": [
        "model"
      ],
      "depends": [
        "quantized_reference"
      ],
      "heavy": true,
      "cache": true,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000
    },
    {
      "id": "vision_export",
      "role": "export",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.embeddinggemma2.convert",
        "--source",
        "$snapshot",
        "--reference",
        "$quantized_reference/reference",
        "--kind",
        "vision",
        "--precision",
        "int4_int8",
        "--output",
        "$out/model"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/convert.py",
        "$adapters/model_wrappers.py",
        "$adapters/contracts.py",
        "$snapshot",
        "$adapters/quantization.py"
      ],
      "outputs": [
        "model"
      ],
      "depends": [
        "quantized_reference"
      ],
      "heavy": true,
      "cache": true,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000
    },
    {
      "id": "bundle",
      "role": "prepare",
      "command": [
        "$python",
        "-m",
        "Tools.Embedding.package_bundle",
        "$out/bundle",
        "--source",
        "$snapshot",
        "--reference",
        "$quantized_reference/reference",
        "--text",
        "$text_export/model",
        "--vision",
        "$vision_export/model"
      ],
      "cwd": "$repo",
      "inputs": [
        "$repo/Tools/Embedding/package_bundle.py",
        "$repo/Tools/Embedding/Licenses/Apache-2.0.txt",
        "$snapshot",
        "$recipe_dir/model.json",
        "$adapters/quantization.py"
      ],
      "outputs": [
        "bundle"
      ],
      "depends": [
        "quantized_reference",
        "text_export",
        "vision_export"
      ],
      "heavy": true,
      "cache": true,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000
    },
    {
      "id": "verify",
      "role": "verify",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.embeddinggemma2.verify",
        "--reference",
        "$quantized_reference/reference",
        "--bundle",
        "$bundle/bundle",
        "--runner",
        "$runner",
        "--out",
        "$out",
        "--original-reference",
        "$reference/reference"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/verify.py",
        "$adapters/contracts.py",
        "$runner",
        "$adapters/quantization.py"
      ],
      "outputs": [
        "comparison.json",
        "vectors.json",
        "plan.json"
      ],
      "depends": [
        "quantized_reference",
        "bundle",
        "reference"
      ],
      "heavy": true,
      "cache": true,
      "timeout_s": 1200,
      "min_free_bytes": 8000000000,
      "checks": [
        {
          "file": "comparison.json",
          "key": [
            "passed"
          ],
          "equals": true
        },
        {
          "file": "comparison.json",
          "key": [
            "count"
          ],
          "equals": 20
        }
      ]
    }
  ]
}

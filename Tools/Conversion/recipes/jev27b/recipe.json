{
  "version": 1,
  "name": "jev27b_typed_decision",
  "description": "Pinned JEV-27B System 1 inputs, reference and converter environments, and fixed evaluation sets.",
  "variables": {
    "adapters": "$repo/Tools/Conversion/adapters/jev27b",
    "fixtures": "$recipe_dir/fixtures"
  },
  "python": "$python",
  "environment": {
    "HF_HOME": "$hf_cache",
    "HF_HUB_CACHE": "$hf_cache/hub",
    "HF_HUB_OFFLINE": "1",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "steps": [
    {
      "id": "prepare",
      "role": "prepare",
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.prepare",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--upstream", "$upstream",
        "--runner", "$runner",
        "--setup", "$setup_record",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$recipe_dir/pyproject.toml",
        "$recipe_dir/uv.lock",
        "$setup_record",
        "${snapshot}.integrity.json",
        "$snapshot/config.json",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/adapter/adapter_config.json",
        "$snapshot/adapter/adapter_model.safetensors",
        "$snapshot/judge_config.json",
        "$snapshot/calibration.json",
        "$snapshot/head.safetensors",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "${base}.integrity.json",
        "$base/tokenizer.json",
        "$base/tokenizer_config.json",
        "$base/chat_template.jinja",
        "$runner"
      ],
      "outputs": ["ready.json"],
      "checks": [{"file": "ready.json", "key": ["ready"], "equals": true}],
      "cache": false,
      "timeout_s": 600
    },
    {
      "id": "fixture",
      "role": "verify",
      "depends": ["prepare"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.fixtures",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out",
        "--check"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$fixtures",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue",
        "$snapshot/config.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja"
      ],
      "outputs": ["F.json", "Q.json", "Cal.json", "H.json", "J.json", "check.json"],
      "checks": [{"file": "check.json", "key": ["passed"], "equals": true}],
      "timeout_s": 1800
    },
    {
      "id": "merge",
      "role": "export",
      "depends": ["prepare"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.merge",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/merge.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "${snapshot}.integrity.json",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/adapter/*",
        "$snapshot/head.safetensors",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$base/config.json"
      ],
      "outputs": ["checkpoint", "manifest.json", "provenance.json"],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 70000000000
    },
    {
      "id": "reference",
      "role": "reference",
      "depends": ["prepare", "fixture"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.reference",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference.py",
        "$adapters/load_check.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/adapter/*",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$fixtures/F.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference.json"],
      "heavy": true,
      "timeout_s": 5400
    },
    {
      "id": "reference_merged",
      "role": "reference",
      "depends": ["prepare", "merge"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.reference_merged",
        "--model", "$recipe_dir/model.json",
        "--merge", "$merge",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference_merged.py",
        "$adapters/reference.py",
        "$adapters/merge.py",
        "$adapters/load_check.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$fixtures/F.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference-merged.json", "hidden.safetensors"],
      "heavy": true,
      "timeout_s": 5400
    },
    {
      "id": "verify_merge",
      "role": "verify",
      "depends": ["merge", "reference", "reference_merged"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.verify_merge",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--merge", "$merge",
        "--reference", "$reference/reference.json",
        "--merged-reference", "$reference_merged/reference-merged.json",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/verify_merge.py",
        "$adapters/merge.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/adapter/*",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$base/config.json"
      ],
      "outputs": ["comparison.json", "reference.json", "report.md"],
      "checks": [{"file": "comparison.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 3600
    }
  ]
}

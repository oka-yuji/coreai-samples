{
  "version": 1,
  "name": "jev27b_typed_decision",
  "description": "Pinned JEV-27B System 1 inputs, reference and converter environments, and fixed evaluation sets.",
  "variables": {
    "adapters": "$repo/Tools/Conversion/adapters/jev27b",
    "fixtures": "$recipe_dir/fixtures",
    "bundle": "jev27b_s1_qwen3_5_cfg_dynamic",
    "bundle_gdnfp32": "jev27b_s1_gdnfp32_qwen3_5_cfg_dynamic",
    "converter": "$upstream/.venv/bin/python",
    "quantization_recipe": "$upstream/models/qwen3_5/qwen3_5_cfg.yaml"
  },
  "python": "$python",
  "environment": {
    "HF_HOME": "$hf_cache",
    "HF_HUB_CACHE": "$hf_cache/hub",
    "HF_HUB_OFFLINE": "1",
    "HF_HUB_DISABLE_TELEMETRY": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "steps": [
    {
      "id": "prepare",
      "role": "prepare",
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.prepare",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--upstream", "$upstream",
        "--runner", "$runner",
        "--setup", "$setup_record",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$recipe_dir/pyproject.toml",
        "$recipe_dir/uv.lock",
        "$setup_record",
        "${snapshot}.integrity.json",
        "$snapshot/config.json",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/adapter/adapter_config.json",
        "$snapshot/adapter/adapter_model.safetensors",
        "$snapshot/judge_config.json",
        "$snapshot/calibration.json",
        "$snapshot/head.safetensors",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "${base}.integrity.json",
        "$base/tokenizer.json",
        "$base/tokenizer_config.json",
        "$base/chat_template.jinja",
        "$runner"
      ],
      "outputs": ["ready.json"],
      "checks": [{"file": "ready.json", "key": ["ready"], "equals": true}],
      "cache": false,
      "timeout_s": 600
    },
    {
      "id": "fixture",
      "role": "verify",
      "depends": ["prepare"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.fixtures",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out",
        "--check"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$fixtures",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue",
        "$snapshot/config.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja"
      ],
      "outputs": ["F.json", "Q.json", "Cal.json", "H.json", "J.json", "check.json"],
      "checks": [{"file": "check.json", "key": ["passed"], "equals": true}],
      "timeout_s": 1800
    },
    {
      "id": "merge",
      "role": "export",
      "depends": ["prepare"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.merge",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/merge.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "${snapshot}.integrity.json",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/adapter/*",
        "$snapshot/head.safetensors",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$base/config.json"
      ],
      "outputs": ["checkpoint", "manifest.json", "provenance.json"],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 70000000000
    },
    {
      "id": "reference",
      "role": "reference",
      "depends": ["prepare", "fixture"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.reference",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference.py",
        "$adapters/load_check.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/adapter/*",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$fixtures/F.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference.json"],
      "heavy": true,
      "timeout_s": 5400
    },
    {
      "id": "reference_merged",
      "role": "reference",
      "depends": ["prepare", "merge"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.reference_merged",
        "--model", "$recipe_dir/model.json",
        "--merge", "$merge",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference_merged.py",
        "$adapters/reference.py",
        "$adapters/merge.py",
        "$adapters/load_check.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$fixtures/F.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference-merged.json", "hidden.safetensors"],
      "heavy": true,
      "timeout_s": 5400
    },
    {
      "id": "export_dry_run",
      "role": "verify",
      "depends": ["prepare", "merge"],
      "command": [
        "$converter", "-m", "Tools.Conversion.adapters.jev27b.export", "dry-run",
        "--model", "$recipe_dir/model.json",
        "--merge", "$merge",
        "--upstream", "$upstream",
        "--recipe", "$quantization_recipe",
        "--bundle", "$bundle",
        "--scratch", "$scratch",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/export.py",
        "$adapters/monitor.py",
        "$adapters/backbone.py",
        "$adapters/decision.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$quantization_recipe"
      ],
      "outputs": ["dry-run.log", "dry-run.json"],
      "checks": [{"file": "dry-run.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 1800,
      "min_free_bytes": 70000000000
    },
    {
      "id": "export",
      "role": "export",
      "depends": ["export_dry_run", "merge"],
      "command": [
        "$converter", "-m", "Tools.Conversion.adapters.jev27b.export", "export",
        "--model", "$recipe_dir/model.json",
        "--merge", "$merge",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--upstream", "$upstream",
        "--recipe", "$quantization_recipe",
        "--bundle", "$bundle",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/export.py",
        "$adapters/monitor.py",
        "$adapters/backbone.py",
        "$adapters/decision.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$quantization_recipe",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$snapshot/judge_config.json",
        "$snapshot/adapter/adapter_config.json",
        "$snapshot/adapter/adapter_model.safetensors",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$base/LICENSE"
      ],
      "outputs": ["jev27b_s1_qwen3_5_cfg_dynamic", "provenance.json", "quantized-hashes.json", "inspect.json"],
      "checks": [{"file": "inspect.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 160000000000
    },
    {
      "id": "export_gdnfp32",
      "role": "export",
      "depends": ["export", "merge", "prepare"],
      "command": [
        "$converter", "-m", "Tools.Conversion.adapters.jev27b.export_variant", "export",
        "--model", "$recipe_dir/model.json",
        "--merge", "$merge",
        "--snapshot", "$snapshot",
        "--base", "$base",
        "--upstream", "$upstream",
        "--recipe", "$quantization_recipe",
        "--bundle", "$bundle_gdnfp32",
        "--baseline", "$export",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/export_variant.py",
        "$adapters/backbone_gdnfp32.py",
        "$adapters/export.py",
        "$adapters/monitor.py",
        "$adapters/backbone.py",
        "$adapters/decision.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$quantization_recipe",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$snapshot/judge_config.json",
        "$snapshot/adapter/adapter_config.json",
        "$snapshot/adapter/adapter_model.safetensors",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$base/LICENSE"
      ],
      "outputs": ["jev27b_s1_gdnfp32_qwen3_5_cfg_dynamic", "provenance.json", "quantized-hashes.json", "inspect.json",
                  "variant.json"],
      "checks": [{"file": "variant.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 160000000000
    },
    {
      "id": "probe_merged",
      "role": "reference",
      "depends": ["export", "fixture", "prepare", "merge"],
      "command": [
        "$converter", "-m", "Tools.Conversion.adapters.jev27b.probe",
        "--stage", "merged",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--merge", "$merge",
        "--export", "$export",
        "--upstream", "$upstream",
        "--recipe", "$quantization_recipe",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--scratch", "$scratch",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/probe.py",
        "$adapters/monitor.py",
        "$adapters/backbone.py",
        "$adapters/decision.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$quantization_recipe",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$fixtures/F.json",
        "$fixtures/Q.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference_q-merged.json", "hidden2.safetensors", "probe.json", "quantized-hashes.json"],
      "checks": [{"file": "probe.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 28800,
      "min_free_bytes": 100000000000
    },
    {
      "id": "probe_base",
      "role": "reference",
      "depends": ["fixture", "prepare"],
      "command": [
        "$converter", "-m", "Tools.Conversion.adapters.jev27b.probe",
        "--stage", "base",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--upstream", "$upstream",
        "--recipe", "$quantization_recipe",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--scratch", "$scratch",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/probe.py",
        "$adapters/monitor.py",
        "$adapters/backbone.py",
        "$adapters/decision.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$quantization_recipe",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$fixtures/F.json",
        "$fixtures/Q.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference_q-base.json", "hidden0q.safetensors", "probe.json", "quantized-hashes-base.json"],
      "checks": [{"file": "probe.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 28800,
      "min_free_bytes": 100000000000
    },
    {
      "id": "verify_quantization",
      "role": "verify",
      "depends": ["probe_merged", "probe_base", "reference", "reference_merged", "export"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.verify_quantization",
        "--model", "$recipe_dir/model.json",
        "--fixtures", "$fixtures",
        "--reference", "$reference/reference.json",
        "--merged-reference", "$reference_merged/reference-merged.json",
        "--probe-merged", "$probe_merged",
        "--probe-base", "$probe_base",
        "--export", "$export",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/verify_quantization.py",
        "$adapters/verify_merge.py",
        "$adapters/decision.py",
        "$adapters/merge.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$fixtures/F.json",
        "$fixtures/Q.json"
      ],
      "outputs": ["reference_q.json", "quantization.json", "report.md"],
      "checks": [{"file": "quantization.json", "key": ["passed"], "equals": true}],
      "timeout_s": 1800
    },
    {
      "id": "typed_input",
      "role": "prepare",
      "depends": ["fixture", "prepare"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.typed_input",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--sets", "F",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/typed_input.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$fixtures/F.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue",
        "$snapshot/config.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja"
      ],
      "outputs": ["input-F.json", "check.json"],
      "checks": [{"file": "check.json", "key": ["passed"], "equals": true}],
      "timeout_s": 1800
    },
    {
      "id": "typed_decide_f",
      "role": "reference",
      "depends": ["export_gdnfp32", "typed_input"],
      "command": [
        "$verify", "typed-decide",
        "--bundle", "$export_gdnfp32/$bundle_gdnfp32",
        "--input", "$typed_input/input-F.json",
        "--output", "$out/swift-F.json"
      ],
      "cwd": "$repo",
      "inputs": ["$recipe_dir/model.json"],
      "outputs": ["swift-F.json"],
      "heavy": true,
      "timeout_s": 14400
    },
    {
      "id": "compare_f",
      "role": "verify",
      "depends": ["typed_decide_f", "verify_quantization"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.compare",
        "--reference", "$verify_quantization/reference_q.json",
        "--set", "F",
        "--swift", "$typed_decide_f/swift-F.json",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/compare.py",
        "$adapters/verify_merge.py",
        "$adapters/merge.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json"
      ],
      "outputs": ["comparison.json", "report.md"],
      "checks": [{"file": "comparison.json", "key": ["passed"], "equals": true}],
      "timeout_s": 600
    },
    {
      "id": "reference_q",
      "role": "reference",
      "depends": ["prepare", "fixture"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.reference_sets",
        "--stage", "peft",
        "--sets", "Q",
        "--model", "$recipe_dir/model.json",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference_sets.py",
        "$adapters/reference.py",
        "$adapters/reference_merged.py",
        "$adapters/merge.py",
        "$adapters/load_check.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/model-*.safetensors",
        "$snapshot/model.safetensors.index.json",
        "$snapshot/config.json",
        "$snapshot/adapter/*",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$snapshot/tokenizer.json",
        "$snapshot/tokenizer_config.json",
        "$snapshot/chat_template.jinja",
        "$fixtures/Q.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference-Q.json"],
      "checks": [{"file": "reference-Q.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 7200
    },
    {
      "id": "reference_merged_q",
      "role": "reference",
      "depends": ["prepare", "merge"],
      "command": [
        "$python", "-m", "Tools.Conversion.adapters.jev27b.reference_sets",
        "--stage", "merged",
        "--sets", "Q",
        "--model", "$recipe_dir/model.json",
        "--merge", "$merge",
        "--snapshot", "$snapshot",
        "--corpus", "$corpus",
        "--jglue", "$jglue",
        "--fixtures", "$fixtures",
        "--output", "$out"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference_sets.py",
        "$adapters/reference_merged.py",
        "$adapters/reference.py",
        "$adapters/merge.py",
        "$adapters/load_check.py",
        "$adapters/fixtures.py",
        "$adapters/prepare.py",
        "$adapters/typed_head.py",
        "$repo/Tools/Conversion/adapters/pinned.py",
        "$repo/Tools/Conversion/storage.py",
        "$recipe_dir/model.json",
        "$snapshot/head.safetensors",
        "$snapshot/calibration.json",
        "$fixtures/Q.json",
        "$fixtures/jglue.json",
        "${corpus}.integrity.json",
        "$corpus",
        "${jglue}.integrity.json",
        "$jglue"
      ],
      "outputs": ["reference-merged-Q.json"],
      "checks": [{"file": "reference-merged-Q.json", "key": ["passed"], "equals": true}],
      "heavy": true,
      "timeout_s": 7200
    },
    {

  "decisions": {
    "prefill": {
      "choice": "One asset per language model: tslm holds embed, prefill and step; ralm holds prefill and step. The functions share the weights and the k_cache and v_cache states.",
      "reason": "A weight-free check with the original MiniCPM layers found the same state descriptors in both functions, prefill-then-step outputs equal to the original up to the last cache position, bit-equal repeats with new or reused states, and a two-function asset 0.3% larger than the step-only asset. Separate prefill assets would store the language-model weights twice. Each export records its size against the unique parameter bytes."
    },
    "embed": {
      "choice": "A separate embed function; prefill takes embeddings.",
      "reason": "A later reference-audio prompt can pass embeddings that mix text and audio features without a new prefill function."
    },
    "state": {
      "choice": "Two states per language model, [layers, 2, capacity, 128]. Each layer reads its cache through where, and a step writes every layer with one scatter_.",
      "reason": "Index assignment aborts specialization. In weight-free models with the real cache shapes, this form matched per-layer states and stayed within about 0.3 ms of their step time at capacity 1024, with 4 arrays instead of 72 for the host. Scatter into each layer slice was fast in three of four configurations but 2.5 times slower in one, for an unknown reason."
    },
    "capacity": {
      "choice": 1024,
      "reason": "T + 1 + min(int(6 * T + 10), 4096) <= 1024 holds for T <= 144 text tokens. The capacity stage records the 2048 step and prefill times; they do not change the contract."
    },
    "prefill_length": {
      "choice": 145,
      "reason": "144 text tokens and the audio start token. Positions from length onward are zero in the cache and do not change the outputs."
    },
    "time_input": {
      "choice": "Float t and dt inputs, as in the original estimator.",
      "reason": "Precomputed time tables selected by step number did not change chained FP16 results in the investigation of 2026-11-16. In FP16 assets t is rounded to float16 before the float32 sinusoidal embedding."
    },
    "vae": {
      "choice": "Streaming decode of one patch with 26 causal convolution states.",
      "reason": "A native host emits audio patch by patch. A whole-utterance decode is not part of the contract."
    },
    "fp16": {
      "choice": "Every asset is also exported in FP16, with RMSNorm and the sinusoidal time embedding computed in float32.",
      "reason": "Errors and times are recorded without acceptance. Mixed precision is a choice of FP32 and FP16 assets, without separate assets."
    }
  },

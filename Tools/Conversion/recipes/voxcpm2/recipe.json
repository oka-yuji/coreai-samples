{
  "version": 1,
  "name": "voxcpm2_components",
  "variables": {
    "adapters": "$repo/Tools/Conversion/adapters/voxcpm2"
  },
  "python": "$python",
  "environment": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "OMP_NUM_THREADS": "4",
    "MKL_NUM_THREADS": "4",
    "USE_OS_COREAI": "1"
  },
  "steps": [
    {
      "id": "reference",
      "role": "reference",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.voxcpm2.reference",
        "--snapshot",
        "$snapshot",
        "--upstream",
        "$upstream",
        "--contract",
        "$recipe_dir/model.json",
        "--fixtures",
        "$recipe_dir/fixtures.json",
        "--output",
        "$out/reference"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/reference.py",
        "$adapters/checks.py",
        "$adapters/source.py",
        "$recipe_dir/model.json",
        "$recipe_dir/fixtures.json",
        "$recipe_dir/requirements.lock",
        "$snapshot",
        "$upstream/src/voxcpm",
        "$upstream/pyproject.toml"
      ],
      "outputs": [
        "reference/reference.json",
        "reference/plain",
        "reference/design",
        "reference/long",
        "reference/heldout_ja",
        "reference/heldout_en"
      ],
      "heavy": true,
      "timeout_s": 7200,
      "min_free_bytes": 10000000000,
      "checks": [
        {
          "file": "reference/reference.json",
          "key": [
            "complete"
          ],
          "equals": true
        }
      ]
    },
    {
      "id": "wrapper_check",
      "role": "verify",
      "depends": [
        "reference"
      ],
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.voxcpm2.wrapper_check",
        "--snapshot",
        "$snapshot",
        "--upstream",
        "$upstream",
        "--contract",
        "$recipe_dir/model.json",
        "--reference",
        "$reference/reference",
        "--output",
        "$out/wrapper"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/wrapper_check.py",
        "$adapters/checks.py",
        "$adapters/runtime.py",
        "$adapters/source.py",
        "$adapters/wrappers.py",
        "$recipe_dir/model.json",
        "$recipe_dir/fixtures.json",
        "$recipe_dir/requirements.lock",
        "$snapshot",
        "$upstream/src/voxcpm",
        "$upstream/pyproject.toml"
      ],
      "outputs": [
        "wrapper/wrapper-check.json",
        "wrapper/rows.json"
      ],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 4000000000,
      "checks": [
        {
          "file": "wrapper/wrapper-check.json",
          "key": [
            "complete"
          ],
          "equals": true
        },
        {
          "file": "wrapper/wrapper-check.json",
          "key": [
            "passed"
          ],
          "equals": true
        }
      ]
    },

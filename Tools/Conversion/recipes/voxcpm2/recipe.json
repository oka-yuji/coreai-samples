{
  "version": 1,
  "name": "voxcpm2_components",
  "variables": {
    "adapters": "$repo/Tools/Conversion/adapters/voxcpm2"
  },
  "python": "$python",
  "environment": {
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "OMP_NUM_THREADS": "4",
    "MKL_NUM_THREADS": "4",
    "USE_OS_COREAI": "1"
  },
  "steps": [
    {
      "id": "reference",
      "role": "reference",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.voxcpm2.reference",
        "--snapshot",
        "$snapshot",
        "--upstream",
        "$upstream",
        "--contract",
        "$recipe_dir/model.json",
        "--fixtures",
        "$recipe_dir/fixtures.json",
        "--output",
        "$out/reference"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters",
        "$recipe_dir/model.json",
        "$recipe_dir/fixtures.json",
        "$recipe_dir/requirements.lock",
        "$snapshot",
        "$upstream/src/voxcpm",
        "$upstream/pyproject.toml"
      ],
      "outputs": [
        "reference/reference.json",
        "reference/plain",
        "reference/design",
        "reference/long",
        "reference/heldout_ja",
        "reference/heldout_en"
      ],
      "heavy": true,
      "timeout_s": 7200,
      "min_free_bytes": 10000000000,
      "checks": [
        {
          "file": "reference/reference.json",
          "key": [
            "complete"
          ],
          "equals": true
        }
      ]
    },
    {
      "id": "wrapper_check",
      "role": "verify",
      "depends": [
        "reference"
      ],
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.voxcpm2.wrapper_check",
        "--snapshot",
        "$snapshot",
        "--upstream",
        "$upstream",
        "--contract",
        "$recipe_dir/model.json",
        "--reference",
        "$reference/reference",
        "--output",
        "$out/wrapper"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters",
        "$recipe_dir/model.json",
        "$recipe_dir/fixtures.json",
        "$recipe_dir/requirements.lock",
        "$snapshot",
        "$upstream/src/voxcpm",
        "$upstream/pyproject.toml"
      ],
      "outputs": [
        "wrapper/wrapper-check.json",
        "wrapper/rows.json"
      ],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 4000000000,
      "checks": [
        {
          "file": "wrapper/wrapper-check.json",
          "key": [
            "complete"
          ],
          "equals": true
        },
        {
          "file": "wrapper/wrapper-check.json",
          "key": [
            "passed"
          ],
          "equals": true
        }
      ]
    },
    {
      "id": "tslm_export",
      "role": "export",
      "command": [
        "$python",
        "-m",
        "Tools.Conversion.adapters.voxcpm2.convert",
        "--snapshot",
        "$snapshot",
        "--upstream",
        "$upstream",
        "--contract",
        "$recipe_dir/model.json",
        "--asset",
        "tslm",
        "--precision",
        "fp32",
        "--precision",
        "fp16",
        "--output",
        "$out/export"
      ],
      "cwd": "$repo",
      "inputs": [
        "$adapters/convert.py",
        "$adapters/wrappers.py",
        "$adapters/source.py",
        "$recipe_dir/model.json",
        "$recipe_dir/requirements.lock",
        "$snapshot",
        "$upstream/src/voxcpm",
        "$upstream/pyproject.toml"
      ],
      "outputs": [
        "export/export.json",
        "export/tslm-fp32.aimodel",
        "export/tslm-fp16.aimodel"
      ],
      "heavy": true,
      "timeout_s": 3600,
      "min_free_bytes": 30000000000,
      "checks": [
        {
          "file": "export/export.json",
          "key": [
            "complete"
          ],
          "equals": true
        }
      ]
    },

{
  "functions": {
    "encode_t256": {
      "inputs": [
        "input_ids",
        "attention_mask",
        "word_idx",
        "word_mask",
        "query_idx",
        "query_mask",
        "cls_idx",
        "cls_mask"
      ],
      "outputs": [
        "start_logits",
        "end_logits",
        "inside_prefix",
        "inside_mean",
        "null_logits",
        "cls_logits",
        "pool_start",
        "pool_end",
        "scorer_start",
        "scorer_end",
        "content_prefix",
        "query_proj"
      ]
    },
    "pair_t256": {
      "inputs": [
        "scorer_start",
        "scorer_end",
        "content_prefix",
        "query_proj",
        "start_logits",
        "end_logits",
        "inside_prefix",
        "inside_mean",
        "word_mask",
        "query_mask",
        "cand_start",
        "cand_end",
        "cand_mask",
        "cand_prior"
      ],
      "outputs": [
        "pair_logits"
      ]
    },
    "encode_t512": {
      "inputs": [
        "input_ids",
        "attention_mask",
        "word_idx",
        "word_mask",
        "query_idx",
        "query_mask",
        "cls_idx",
        "cls_mask"
      ],
      "outputs": [
        "start_logits",
        "end_logits",
        "inside_prefix",
        "inside_mean",
        "null_logits",
        "cls_logits",
        "pool_start",
        "pool_end",
        "scorer_start",
        "scorer_end",
        "content_prefix",
        "query_proj"
      ]
    },
    "pair_t512": {
      "inputs": [
        "scorer_start",
        "scorer_end",
        "content_prefix",
        "query_proj",
        "start_logits",
        "end_logits",
        "inside_prefix",
        "inside_mean",
        "word_mask",
        "query_mask",
        "cand_start",
        "cand_end",
        "cand_mask",
        "cand_prior"
      ],
      "outputs": [
        "pair_logits"
      ]
    }
  },
  "caps": {
    "tokens": [
      256,
      512
    ],
    "queries": 16,
    "class_labels": 16,
    "candidates": 192,
    "boundaries": "T + 1",
    "words": "T"
  },
  "host": {
    "pool_boundary_top_k": 32,
    "pool_size": 192,
    "min_pool_per_query": 8,
    "mask_logit": -10000.0,
    "quota_score_base": 5000.0,
    "pair_temperature": 1.0,
    "classification_temperature": 1.0,
    "abstention_threshold": 0.5,
    "overlap_policy": "flat",
    "default_threshold": 0.5,
    "token_pooling": "first",
    "append_period_unless_text_ends_with": [
      ".",
      "!",
      "?"
    ]
  }
}
